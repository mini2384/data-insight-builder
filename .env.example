# Gemini API 설정
# Google AI Studio(https://aistudio.google.com/)에서 발급받은 API 키를 입력하세요.
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델명 (예: gemini-2.5-flash 또는 gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Flask 디버그 모드 (true / false)
FLASK_DEBUG=true

# 파일 업로드 최대 크기 (MB 단위)
MAX_UPLOAD_MB=10

# 4자리 비공개 보안 비밀번호 예시
APP_PIN_CODE=0000

# Flask 세션 암호화 비밀키
SECRET_KEY=your_secret_key_here
